# ============================================
# AIMCRS India Traffic Dataset — Environment Variables
# ============================================
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys below
# 3. NEVER share your .env file or commit it to Git
# ============================================

# ----- GOOGLE (You already have this key) -----
# Used for: Google Maps data (if terms of service allow)
GOOGLE_API_KEY=your_google_api_key_here

# ----- KAGGLE (Free Account Required) -----
# How to get:
#   1. Go to kaggle.com and create a free account
#   2. Click your profile picture (top right) → Settings
#   3. Scroll to "API" section → Click "Create New Token"
#   4. This downloads kaggle.json — open it and copy values below
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# ----- ROBOFLOW (Free Account Required for Some Datasets) -----
# How to get:
#   1. Go to roboflow.com and create a free account
#   2. Go to Settings → API Keys
#   3. Copy your API key below
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ----- DATA.GOV.IN (Free — No Account Needed for Basic Access) -----
# How to get:
#   1. Go to data.gov.in
#   2. Click "API" in the top menu
#   3. Register for a free API key
DATA_GOV_IN_API_KEY=your_data_gov_in_key_here

# ----- TOMTOM (Free Tier — 2500 Requests/Day) -----
# How to get:
#   1. Go to developer.tomtom.com
#   2. Create a free account
#   3. Go to Dashboard → Keys
#   4. Copy your API key
# ⚠️ FREE TIER: 2,500 requests per day. Paid after that.
TOMTOM_API_KEY=your_tomtom_api_key_here

# ----- HERE MAPS (Free Tier — 250K Requests/Month) -----
# How to get:
#   1. Go to developer.here.com
#   2. Create a free account
#   3. Create a new project → Generate API key
# ⚠️ FREE TIER: 250,000 requests per month. Paid after that.
HERE_API_KEY=your_here_api_key_here

# ----- MAPMYINDIA / MAPPLS (Free Tier Available) -----
# How to get:
#   1. Go to maps.mapmyindia.com
#   2. Create a free developer account
#   3. Go to Dashboard → API Keys
# ⚠️ FREE TIER: Limited requests. Check their pricing page.
MAPPLS_CLIENT_ID=your_mappls_client_id_here
MAPPLS_CLIENT_SECRET=your_mappls_client_secret_here

# ----- GENERAL SETTINGS -----
# How many downloads to run at the same time (keep low to be polite)
MAX_CONCURRENT_DOWNLOADS=2

# Seconds to wait between downloads (be polite to servers)
DOWNLOAD_DELAY_SECONDS=5

# Where to store log files
LOG_DIR=logs
